# Copy to .env. Only fill what you actually intend to use.
# Textbelt ships with a shared key: 1 free SMS per day, then out-of-quota.
PACIFICATION_TEXTBELT_KEY=textbelt

# Paid/keyed gateways. Empty values make the matching provider skip itself.
PACIFICATION_TWILIO_SID=
PACIFICATION_TWILIO_TOKEN=
PACIFICATION_TWILIO_FROM=
PACIFICATION_TWILIO_TWIML_URL=https://demo.twilio.com/docs/voice.xml

PACIFICATION_VONAGE_KEY=
PACIFICATION_VONAGE_SECRET=
PACIFICATION_VONAGE_FROM=Pacification

PACIFICATION_SMS_TO_KEY=
PACIFICATION_SMS_TO_SENDER=Pacification

PACIFICATION_MAILERSEND_KEY=
PACIFICATION_MAILERSEND_FROM=

PACIFICATION_FREE2SMS_KEY=
PACIFICATION_FREE2SMS_SENDER=PACI01

PACIFICATION_TOPSMS_ID=
PACIFICATION_TOPSMS_SECRET=

PACIFICATION_ISMS_KEY=
PACIFICATION_ISMS_SENDER=Pacification

PACIFICATION_8X8_SUBACCOUNT=
PACIFICATION_8X8_TOKEN=

PACIFICATION_LOX24_TOKEN=
